  )
;

predicate varUpdate(var bool: result, var bool: update, var bool: newValue,
    var bool: oldValue) =
  (result = [oldValue,newValue][1+bool2int(update)])
;

predicate varUpdate(var int: result, var bool: update, var int: newValue,
    var int: oldValue) =
  (result = [oldValue,newValue][1+bool2int(update)])
;

